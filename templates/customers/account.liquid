<div class="section">
  <div class="container" style="max-width:800px">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:2rem">
      <h1 style="margin:0">{{ 'customer.account.title' | t }}</h1>
      <a href="{{ routes.account_logout_url }}" class="btn btn--outline btn--sm">{{ 'customer.log_out' | t }}</a>
    </div>

    <div class="grid-2">
      <div>
        <h2 style="font-size:1.15rem">{{ 'customer.orders.title' | t }}</h2>
        {%- if customer.orders.size > 0 -%}
          {%- for order in customer.orders -%}
            <a href="{{ order.customer_url }}" class="card" style="display:block;margin-bottom:0.75rem">
              <strong>{{ order.name }}</strong>
              <div class="muted" style="font-size:0.85rem">{{ order.created_at | date: '%B %d, %Y' }} · {{ order.financial_status_label }} · {{ order.total_price | money }}</div>
            </a>
          {%- endfor -%}
        {%- else -%}
          <p class="muted">{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}
      </div>
      <div>
        <h2 style="font-size:1.15rem">{{ 'customer.account.details' | t }}</h2>
        <p>{{ customer.name }}<br>{{ customer.email }}</p>
        <a href="{{ routes.account_addresses_url }}" class="btn btn--outline btn--sm">{{ 'customer.account.view_addresses' | t }}</a>
      </div>
    </div>
  </div>
</div>
