<div class="section">
  <div class="container" style="max-width:480px">
    <h1>{{ 'customer.activate_account.title' | t }}</h1>
    <p class="muted">{{ 'customer.activate_account.subtext' | t }}</p>
    {% form 'activate_customer_password' %}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="Password">{{ 'customer.activate_account.password' | t }}</label>
        <input type="password" name="customer[password]" id="Password">
      </div>
      <div class="field">
        <label for="PasswordConfirmation">{{ 'customer.activate_account.password_confirm' | t }}</label>
        <input type="password" name="customer[password_confirmation]" id="PasswordConfirmation">
      </div>
      <button type="submit" class="btn btn--primary">{{ 'customer.activate_account.submit' | t }}</button>
    {% endform %}
  </div>
</div>
