<section class="collection-header">
  <div class="container">
    <span class="section__eyebrow">Collections</span>
    <h1 class="section__heading">Shop JustNatur</h1>
    <p class="section__subheading" style="margin-inline:auto">Three products. One inside-out philosophy.</p>
  </div>
</section>

<section class="container collection-grid">
  {%- for collection in collections -%}
    {%- unless collection.handle == 'frontpage' -%}
      <a href="{{ collection.url }}" class="product-card">
        <div class="product-card__media">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="product-card__body">
          <h2 class="product-card__title">{{ collection.title }}</h2>
          <p class="muted" style="font-size:0.9rem;margin:0">{{ collection.products_count }} products</p>
        </div>
      </a>
    {%- endunless -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "List collections",
  "settings": []
}
{% endschema %}
