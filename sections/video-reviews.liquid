<section class="section section--light">
  <div class="container">
    <div class="section__header section__header--center reveal">
      <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section__heading">{{ section.settings.heading }}</h2>
      <p class="section__subheading">{{ section.settings.text }}</p>
    </div>
    <div class="video-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="video-thumb reveal" {{ block.shopify_attributes }} {% if block.settings.link != blank %}target="_blank" rel="noopener"{% endif %}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', style: 'width:100%;height:100%;object-fit:cover;position:absolute;inset:0' }}
          {%- endif -%}
          <span class="video-thumb__play">{% render 'icon', icon: 'play' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Watch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Video reviews"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Real customers. Real rituals."
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Thumbnail" },
        { "type": "url", "id": "link", "label": "Video URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video reviews",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
