<section class="page-hero">
  <div class="container">
    <span class="section__eyebrow">Reviews</span>
    <h1 class="page-hero__title">{{ section.settings.heading }}</h1>
    <p class="page-hero__text">{{ section.settings.subheading }}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section__header reveal">
      <h2>Video testimonials</h2>
      <p class="section__subheading">Real customers. Real rituals.</p>
    </div>
    <div class="video-grid" style="margin-bottom:4rem">
      {%- for i in (1..4) -%}
        <div class="video-thumb">
          <span class="video-thumb__play">{% render 'icon', icon: 'play' %}</span>
        </div>
      {%- endfor -%}
    </div>

    <div class="section__header reveal">
      <h2>What they're saying</h2>
    </div>
    <div class="grid-3">
      {%- for block in section.blocks -%}
        <article class="testimonial-card reveal" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars">★★★★★</div>
          <p class="testimonial-card__quote">"{{ block.settings.quote }}"</p>
          <div class="testimonial-card__author">{{ block.settings.author }}</div>
          <div class="testimonial-card__meta">{{ block.settings.meta }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let customers speak for us."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Stories from people who chose nutrition over another bottle of empty promises."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Honest, clean ingredients that work." },
        { "type": "text", "id": "author", "label": "Author", "default": "Customer" },
        { "type": "text", "id": "meta", "label": "Meta", "default": "Verified buyer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews page",
      "blocks": [
        { "type": "review", "settings": { "quote": "I'd been losing hair for 2 years. 10 weeks into Kesha Mula, I have baby hairs growing back at my temples.", "author": "Ananya R.", "meta": "Verified · Kesha Mula" } },
        { "type": "review", "settings": { "quote": "The chatpata taste made me look forward to taking it. Hair fall in the shower reduced dramatically.", "author": "Rohit S.", "meta": "Verified · Kesha Combo" } },
        { "type": "review", "settings": { "quote": "Post-partum hair fall was destroying my confidence. By week 6 the shedding slowed noticeably.", "author": "Meera K.", "meta": "Verified · Kesha Mula" } },
        { "type": "review", "settings": { "quote": "I got my sister to try this and now we're both on month 3. Just honest nutrition.", "author": "Divya P.", "meta": "Verified · Combo" } },
        { "type": "review", "settings": { "quote": "Finally a brand that explains the science instead of shouting discounts.", "author": "Karthik M.", "meta": "Verified · Kesha Amrith" } },
        { "type": "review", "settings": { "quote": "90 days felt doable because the ritual is simple. One spoon every morning.", "author": "Sneha T.", "meta": "Verified · Kesha Mula" } }
      ]
    }
  ]
}
{% endschema %}
