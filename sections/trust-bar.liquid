<section class="section" style="padding:2rem 0">
  <div class="container">
    <div class="trust-row reveal">
      {%- for block in section.blocks -%}
        <div class="trust-item" {{ block.shopify_attributes }}>
          {% render 'icon', icon: block.settings.icon %}
          <span>{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "check", "label": "Check" },
            { "value": "heart", "label": "Heart" },
            { "value": "science", "label": "Science" },
            { "value": "seed", "label": "Seed" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "100% Natural" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "badge", "settings": { "icon": "leaf", "label": "100% Natural" } },
        { "type": "badge", "settings": { "icon": "shield", "label": "FSSAI Certified" } },
        { "type": "badge", "settings": { "icon": "check", "label": "No Preservatives" } },
        { "type": "badge", "settings": { "icon": "seed", "label": "Ayurvedic Formula" } },
        { "type": "badge", "settings": { "icon": "heart", "label": "Made in India" } },
        { "type": "badge", "settings": { "icon": "science", "label": "Founder Tested" } }
      ]
    }
  ]
}
{% endschema %}
