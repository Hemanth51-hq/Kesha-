<section class="page-hero">
  <div class="container">
    <span class="section__eyebrow">Science</span>
    <h1 class="page-hero__title">{{ section.settings.heading }}</h1>
    <p class="page-hero__text">{{ section.settings.subheading }}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    {%- for block in section.blocks -%}
      <div class="research-block reveal" {{ block.shopify_attributes }}>
        <div class="research-block__label">{{ block.settings.label }}</div>
        <div>
          <h2 style="font-size:clamp(1.4rem,3vw,1.85rem);margin-bottom:0.75rem">{{ block.settings.title }}</h2>
          <div class="rte muted">{{ block.settings.text }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Science page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hair needs more than hope. It needs nutrition."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A research-style look at the hair growth cycle, follicles, nutrients, stress, hormones and how Ayurveda supports long-term hair health."
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Hair growth cycle" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hair moves through anagen (growth), catagen (transition) and telogen (rest/shed). A full visible shift often takes around 90 days of consistent care.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science page",
      "blocks": [
        { "type": "topic", "settings": { "label": "Cycle", "title": "Hair growth cycle", "text": "<p>Hair moves through anagen (growth), catagen (transition) and telogen (rest/shed). A full visible shift often takes around 90 days of consistent care — which is why JustNatur is built as a 90-day ritual, not a weekend fix.</p>" } },
        { "type": "topic", "settings": { "label": "Follicles", "title": "Hair follicles need fuel", "text": "<p>Follicles are metabolically active mini-organs. When nutrition, sleep or stress dips, shedding and thinning often follow. External oils can condition strands — they cannot replace internal fuel.</p>" } },
        { "type": "topic", "settings": { "label": "Iron", "title": "Iron & hair", "text": "<p>Low iron stores are commonly linked with increased shedding. Food-based sources and seed nutrition are part of how Kesha Mula supports daily micronutrient intake.</p>" } },
        { "type": "topic", "settings": { "label": "Zinc", "title": "Zinc & protein", "text": "<p>Zinc and adequate protein support keratin production and follicle function. Pumpkin seeds, sesame and related botanicals contribute naturally occurring minerals and amino acids.</p>" } },
        { "type": "topic", "settings": { "label": "Stress", "title": "Stress & sleep", "text": "<p>Chronic stress can push more follicles into the shedding phase. Sleep quality compounds the effect. Adaptogenic herbs like Ashwagandha are included to support the body's stress response as part of overall wellness.</p>" } },
        { "type": "topic", "settings": { "label": "Hormones", "title": "Hormones & postpartum", "text": "<p>Hormonal shifts — including postpartum — frequently show up in hair density. JustNatur does not claim to treat medical conditions; we focus on nutritional support while you work with your clinician when needed.</p>" } },
        { "type": "topic", "settings": { "label": "Scalp", "title": "Scalp environment", "text": "<p>A healthy scalp supports strand quality. Kesha Amrith Hair Oil is designed for massage, nourishment, shine and softness — the outside half of the inside-out system.</p>" } },
        { "type": "topic", "settings": { "label": "Ayurveda", "title": "How Ayurveda supports hair", "text": "<p>Classics like Amla, Bhringraj, Fenugreek and Curry leaf have long traditional associations with hair vitality. We pair that wisdom with modern nutritional thinking — without inventing miracle chemicals.</p>" } },
        { "type": "topic", "settings": { "label": "Modern", "title": "How modern nutrition supports hair", "text": "<p>Functional nutrition looks at deficiencies, absorption and consistency. Powdered whole-food blends can offer broader spectrum nutrition than a single synthetic isolate.</p>" } }
      ]
    }
  ]
}
{% endschema %}
