<section class="section section--light">
  <div class="container">
    <div class="section__header section__header--center reveal">
      <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section__heading">{{ section.settings.heading }}</h2>
      <p class="section__subheading">{{ section.settings.text }}</p>
    </div>
    <div class="problem-grid">
      {%- for block in section.blocks -%}
        <div class="problem-item reveal reveal-delay-{{ forloop.index | modulo: 3 }}" {{ block.shopify_attributes }}>
          <div class="problem-item__num">0{{ forloop.index }}</div>
          <h3 class="problem-item__title">{{ block.settings.title }}</h3>
          <p class="problem-item__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Problem section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The real problem"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hair fall isn't one problem. It's five."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Every oil, shampoo, and capsule you've tried only treats the surface. Real hair fall comes from within, and it has five distinct root causes."
    }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Nutritional gaps" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Missing iron, zinc, protein and micronutrients weaken follicles from the inside." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problem section",
      "blocks": [
        { "type": "problem", "settings": { "title": "Nutritional gaps", "text": "Missing iron, zinc, protein and micronutrients weaken follicles from the inside." } },
        { "type": "problem", "settings": { "title": "Stress load", "text": "Chronic stress pushes hair into shedding phase earlier than it should." } },
        { "type": "problem", "settings": { "title": "Hormonal shifts", "text": "Postpartum, PCOS and thyroid changes often show up first in the hairline." } },
        { "type": "problem", "settings": { "title": "Weak follicles", "text": "Years of surface-only care leave roots undernourished and brittle." } },
        { "type": "problem", "settings": { "title": "Lifestyle drift", "text": "Poor sleep, low protein diets and irregular routines quietly accelerate fall." } }
      ]
    }
  ]
}
{% endschema %}
