<section class="section">
  <div class="container">
    <div class="section__header section__header--center reveal">
      <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section__heading">{{ section.settings.heading }}</h2>
      <p class="section__subheading">{{ section.settings.text }}</p>
    </div>

    <div style="overflow-x:auto" class="reveal">
      <table class="compare-table">
        <thead>
          <tr>
            <th>Approach</th>
            <th>Typical oils & shampoos</th>
            <th>Single biotin pills</th>
            <th class="is-featured">Kesha Combo</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.feature }}</td>
              <td>{{ block.settings.col_a }}</td>
              <td>{{ block.settings.col_b }}</td>
              <td class="is-featured"><span class="check">{{ block.settings.col_c }}</span></td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product comparison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Compare"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why choose JustNatur"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Inside-out care versus surface-only routines."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Addresses nutrition" },
        { "type": "text", "id": "col_a", "label": "Column A", "default": "—" },
        { "type": "text", "id": "col_b", "label": "Column B", "default": "Limited" },
        { "type": "text", "id": "col_c", "label": "Kesha Combo", "default": "✓ Full-spectrum" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product comparison",
      "blocks": [
        { "type": "row", "settings": { "feature": "Addresses root nutrition", "col_a": "—", "col_b": "Limited", "col_c": "✓ Yes" } },
        { "type": "row", "settings": { "feature": "External scalp care", "col_a": "✓", "col_b": "—", "col_c": "✓ Yes" } },
        { "type": "row", "settings": { "feature": "Whole-food / Ayurvedic blend", "col_a": "Sometimes", "col_b": "Synthetic isolate", "col_c": "✓ Food-based" } },
        { "type": "row", "settings": { "feature": "Designed for 90-day cycle", "col_a": "—", "col_b": "—", "col_c": "✓ Ritual-led" } },
        { "type": "row", "settings": { "feature": "No fake urgency / miracle claims", "col_a": "Varies", "col_b": "Varies", "col_c": "✓ Honest" } }
      ]
    }
  ]
}
{% endschema %}
