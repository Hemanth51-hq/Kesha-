<article class="section">
  <div class="container container--narrow">
    <header style="margin-bottom:2rem;text-align:center">
      <time class="section__eyebrow" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
      <h1>{{ article.title }}</h1>
    </header>
    {%- if article.image -%}
      {{ article.image | image_url: width: 1400 | image_tag: loading: 'eager', style: 'border-radius:var(--radius);width:100%;margin-bottom:2rem' }}
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
