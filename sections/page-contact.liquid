<section class="page-hero">
  <div class="container">
    <span class="section__eyebrow">Contact</span>
    <h1 class="page-hero__title">{{ section.settings.heading }}</h1>
    <p class="page-hero__text">{{ section.settings.subheading }}</p>
  </div>
</section>

<section class="section">
  <div class="container contact-grid">
    <div class="reveal">
      <div class="contact-info__item">
        <div class="contact-info__label">Email</div>
        <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
      </div>
      {%- if settings.social_whatsapp != blank -%}
        <div class="contact-info__item">
          <div class="contact-info__label">WhatsApp</div>
          <a href="https://wa.me/{{ settings.social_whatsapp }}" target="_blank" rel="noopener">Chat with us</a>
        </div>
      {%- endif -%}
      <div class="contact-info__item">
        <div class="contact-info__label">Address</div>
        <p class="muted" style="margin:0">{{ settings.store_address }}</p>
      </div>
      <div class="contact-info__item">
        <div class="contact-info__label">Business hours</div>
        <p class="muted" style="margin:0">{{ section.settings.hours }}</p>
      </div>
    </div>

    <div class="reveal">
      {% form 'contact', class: 'contact-form' %}
        {%- if form.posted_successfully? -%}
          <p style="color:var(--color-primary);font-weight:600;margin-bottom:1rem">Thanks — we'll get back to you soon.</p>
        {%- endif -%}
        {{ form.errors | default_errors }}
        <div class="field">
          <label for="ContactName">Name</label>
          <input type="text" id="ContactName" name="contact[name]" required>
        </div>
        <div class="field">
          <label for="ContactEmail">Email</label>
          <input type="email" id="ContactEmail" name="contact[email]" required>
        </div>
        <div class="field">
          <label for="ContactPhone">Phone</label>
          <input type="tel" id="ContactPhone" name="contact[phone]">
        </div>
        <div class="field">
          <label for="ContactMessage">Message</label>
          <textarea id="ContactMessage" name="contact[body]" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Send message</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're here to help."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Questions about your 90-day ritual, shipping or ingredients? Reach out."
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Business hours",
      "default": "Mon–Sat · 10:00 AM – 6:00 PM IST"
    }
  ],
  "presets": [{ "name": "Contact page" }]
}
{% endschema %}
