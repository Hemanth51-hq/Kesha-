<section class="password-page">
  <div class="password-page__inner">
    <h1 class="password-page__brand">{{ shop.name }}</h1>
    <p class="password-page__tagline">Fix the Root. Stop the Fall.</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="Password">Enter store password</label>
        <input type="password" name="password" id="Password" autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn--primary btn--full">Enter</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
