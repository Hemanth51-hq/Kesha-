<section class="section section--light">
  <div class="container">
    <div class="section__header section__header--center reveal">
      <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section__heading">{{ section.settings.heading }}</h2>
      <p class="section__subheading">{{ section.settings.text }}</p>
    </div>
    <div class="grid-3">
      {%- assign recs = section.settings.collection -%}
      {%- if recs != blank -%}
        {%- for product in recs.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for product in collections.all.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recommended products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Complete the ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recommended with this"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Prioritise the Kesha Combo for full inside-out care."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products to show",
      "default": 3
    }
  ],
  "presets": [{ "name": "Recommended products" }]
}
{% endschema %}
