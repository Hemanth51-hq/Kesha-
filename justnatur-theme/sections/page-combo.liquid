<section class="hero hero--split">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '800,1200,1600', sizes: '50vw' }}
    {%- else -%}
      <div style="width:100%;height:100%;min-height:50vh;background:linear-gradient(145deg,var(--color-text),#3a3a3a)"></div>
    {%- endif -%}
  </div>
  <div class="hero__content reveal">
    <div class="hero__brand">Flagship</div>
    <h1 class="hero__title">{{ section.settings.heading }}</h1>
    <p class="hero__text">{{ section.settings.text }}</p>
    <div class="btn-group">
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn--primary btn--lg">{{ section.settings.button_label }}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section__header section__header--center reveal">
      <span class="section__eyebrow">Why together</span>
      <h2 class="section__heading">{{ section.settings.why_heading }}</h2>
      <p class="section__subheading">{{ section.settings.why_text }}</p>
    </div>
    <div class="inside-out reveal">
      <div class="inside-out__side inside-out__side--active">
        <div class="inside-out__label">Inside</div>
        <h3 class="inside-out__title">Kesha Mula</h3>
        <p class="muted">Daily Ayurvedic nutrition powder. Feed the follicle.</p>
      </div>
      <div class="inside-out__arrow">+</div>
      <div class="inside-out__side">
        <div class="inside-out__label">Outside</div>
        <h3 class="inside-out__title">Kesha Amrith</h3>
        <p class="muted">Herbal hair oil. Protect and nourish the scalp.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section--light">
  <div class="container">
    <div class="section__header section__header--center reveal">
      <span class="section__eyebrow">Routine</span>
      <h2 class="section__heading">Your complete daily ritual</h2>
    </div>
    <div class="steps">
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          <div class="step reveal" {{ block.shopify_attributes }}>
            <h3 class="step__title">{{ block.settings.title }}</h3>
            <p class="step__text">{{ block.settings.text }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section__header section__header--center reveal">
      <span class="section__eyebrow">Benefits</span>
      <h2 class="section__heading">Nutrition inside. Protection outside.</h2>
    </div>
    <div class="grid-3">
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          <div class="card reveal" {{ block.shopify_attributes }}>
            <h3 style="font-size:1.1rem">{{ block.settings.title }}</h3>
            <p class="muted" style="margin:0">{{ block.settings.text }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="text-center" style="margin-top:3rem">
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn--primary btn--lg">{{ section.settings.button_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Combo landing",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kesha Combo"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "India's First Inside-Out Hair Care System. Kesha Mula + Kesha Amrith Hair Oil. Complete daily ritual."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Shop the Combo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "why_heading",
      "label": "Why heading",
      "default": "Why the combination works better"
    },
    {
      "type": "textarea",
      "id": "why_text",
      "label": "Why text",
      "default": "Oils alone treat the surface. Nutrition alone misses scalp care. Together they form the complete JustNatur system."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Routine step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Morning" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Drink Kesha Mula on an empty stomach." }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Stronger roots" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Internal nutrition supports follicle health." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Combo landing",
      "blocks": [
        { "type": "step", "settings": { "title": "Morning", "text": "Drink Kesha Mula mixed with water, buttermilk or juice." } },
        { "type": "step", "settings": { "title": "2–3× weekly", "text": "Massage Kesha Amrith into the scalp. Leave on. Wash as usual." } },
        { "type": "step", "settings": { "title": "Stay consistent", "text": "Follow for 90 days — one full hair growth cycle." } },
        { "type": "step", "settings": { "title": "Track gently", "text": "Notice shed, texture and confidence — not overnight miracles." } },
        { "type": "benefit", "settings": { "title": "Supports healthy growth", "text": "Feed follicles from within with whole-food nutrition." } },
        { "type": "benefit", "settings": { "title": "Helps reduce hair fall", "text": "Address root causes instead of masking symptoms." } },
        { "type": "benefit", "settings": { "title": "Scalp nourishment", "text": "Oil ritual for shine, softness and scalp comfort." } }
      ]
    }
  ]
}
{% endschema %}
