<section class="section section--dark">
  <div class="container">
    <div class="section__header section__header--center reveal">
      <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section__heading">{{ section.settings.heading }}</h2>
      <p class="section__subheading">{{ section.settings.text }}</p>
    </div>

    <div class="grid-3">
      {%- for block in section.blocks -%}
        <div class="card" style="background:rgba(255,255,255,0.04);border-color:rgba(255,255,255,0.08);color:#fff" {{ block.shopify_attributes }}>
          <div class="problem-item__num" style="color:var(--color-accent)">{{ block.settings.label }}</div>
          <h3 class="problem-item__title" style="color:#fff">{{ block.settings.title }}</h3>
          <p class="problem-item__text" style="color:rgba(255,255,255,0.7)">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why oils alone fail",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The outside-only trap"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why oils alone don't work"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Oils, shampoos and serums can support the scalp — but they cannot replace the nutrients your follicles need to grow stronger hair."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Tried" },
        { "type": "text", "id": "title", "label": "Title", "default": "Hair oils & serums" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Help with dryness and shine, not internal deficiencies." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why oils alone fail",
      "blocks": [
        { "type": "item", "settings": { "label": "Tried", "title": "Oils & shampoos", "text": "Support the surface. They cannot feed the follicle from within." } },
        { "type": "item", "settings": { "label": "Tried", "title": "Biotin capsules", "text": "A single nutrient rarely fixes multi-deficiency hair fall." } },
        { "type": "item", "settings": { "label": "Tried", "title": "Minoxidil & shortcuts", "text": "Temporary density without addressing root nutritional causes." } }
      ]
    }
  ]
}
{% endschema %}
