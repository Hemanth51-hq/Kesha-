<section class="section section--light">
  <div class="container">
    <div class="section__header section__header--center reveal">
      <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section__heading">{{ section.settings.heading }}</h2>
      <p class="section__subheading">{{ section.settings.text }}</p>
    </div>

    <div class="inside-out reveal">
      <div class="inside-out__side inside-out__side--active">
        <div class="inside-out__label">Inside</div>
        <h3 class="inside-out__title">{{ section.settings.inside_title }}</h3>
        <p class="muted" style="margin:0;margin-inline:auto">{{ section.settings.inside_text }}</p>
      </div>
      <div class="inside-out__arrow" aria-hidden="true">+</div>
      <div class="inside-out__side">
        <div class="inside-out__label">Outside</div>
        <h3 class="inside-out__title">{{ section.settings.outside_title }}</h3>
        <p class="muted" style="margin:0;margin-inline:auto">{{ section.settings.outside_text }}</p>
      </div>
    </div>

    <div class="flagship-banner reveal" style="margin-top:3rem">
      <div>
        <div class="flagship-banner__eyebrow">Flagship system</div>
        <h3 class="flagship-banner__title">{{ section.settings.cta_title }}</h3>
        <p class="flagship-banner__text">{{ section.settings.cta_text }}</p>
      </div>
      <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="btn btn--primary">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Inside-out concept",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The JustNatur method"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Inside-Out Hair Care System"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Nutrition inside. Protection outside. One daily ritual designed for long-term hair health."
    },
    {
      "type": "text",
      "id": "inside_title",
      "label": "Inside title",
      "default": "Kesha Mula"
    },
    {
      "type": "textarea",
      "id": "inside_text",
      "label": "Inside text",
      "default": "Ayurvedic hair nutrition blend. One serving every morning. Whole-food powder for faster absorption."
    },
    {
      "type": "text",
      "id": "outside_title",
      "label": "Outside title",
      "default": "Kesha Amrith Oil"
    },
    {
      "type": "textarea",
      "id": "outside_text",
      "label": "Outside text",
      "default": "Herbal-infused scalp oil for massage, shine, softness and a healthier scalp environment."
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "CTA title",
      "default": "Kesha Combo — India's First Inside-Out Hair Care System"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "CTA text",
      "default": "The complete daily ritual. Prioritised as our flagship offer for a full 90-day transformation journey."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop Kesha Combo"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "presets": [{ "name": "Inside-out concept" }]
}
{% endschema %}
