<section class="section section--light">
  <div class="container container--narrow">
    <div class="section__header section__header--center reveal">
      <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section__heading">{{ section.settings.heading }}</h2>
      <p class="section__subheading">{{ section.settings.text }}</p>
    </div>

    <div class="accordion" data-accordion="single">
      {%- for block in section.blocks -%}
        <div class="accordion__item{% if forloop.first and section.settings.open_first %} is-open{% endif %}" {{ block.shopify_attributes }}>
          <button type="button" class="accordion__trigger" aria-expanded="{% if forloop.first and section.settings.open_first %}true{% else %}false{% endif %}">
            <span>{{ block.settings.question }}</span>
            <span class="accordion__icon" aria-hidden="true"></span>
          </button>
          <div class="accordion__panel">{{ block.settings.answer }}</div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footer_text != blank -%}
      <p class="text-center muted" style="margin-top:2rem">{{ section.settings.footer_text }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you need to know."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Honest answers. No fake urgency."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item",
      "default": true
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Can't find your answer? Write to us at hello@justnatur.in"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long until I notice a difference?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Hair grows on roughly a 90-day cycle. Many people notice reduced shedding earlier, but we encourage a full 90 days of consistent use." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "How long until I notice a difference?", "answer": "Hair grows on roughly a 90-day cycle. Many people notice reduced shedding earlier, but we encourage a full 90 days of consistent use. Individual results vary." } },
        { "type": "faq", "settings": { "question": "How do I take Kesha Mula?", "answer": "Take one serving every morning. Mix with water, buttermilk or juice. Drink on an empty stomach for best absorption." } },
        { "type": "faq", "settings": { "question": "Can men and women both use it?", "answer": "Yes. Kesha Mula and Kesha Amrith are formulated for adults experiencing hair fall, thinning and weak roots — including stress-related and postpartum hair fall." } },
        { "type": "faq", "settings": { "question": "Is it safe during pregnancy?", "answer": "Please consult your healthcare professional before use if you are pregnant, breastfeeding, or on medication." } },
        { "type": "faq", "settings": { "question": "Why powder instead of capsules?", "answer": "Powder offers faster absorption, whole-food nutrition and easier digestion — without synthetic vitamin isolates." } },
        { "type": "faq", "settings": { "question": "Do you ship across India?", "answer": "Yes. Free shipping on prepaid orders. COD available where supported." } }
      ]
    }
  ]
}
{% endschema %}
