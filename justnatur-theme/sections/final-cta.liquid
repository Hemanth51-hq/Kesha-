<section class="section section--primary">
  <div class="container text-center reveal">
    <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="section__heading" style="max-width:16ch;margin-inline:auto">{{ section.settings.heading }}</h2>
    <p class="section__subheading" style="margin-inline:auto;color:rgba(255,255,255,0.85)">{{ section.settings.text }}</p>
    <div class="btn-group" style="justify-content:center">
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn--secondary btn--lg">{{ section.settings.button_label }}</a>
    </div>
    {%- if section.settings.fine_print != blank -%}
      <p style="margin-top:1.25rem;font-size:0.85rem;opacity:0.8">{{ section.settings.fine_print }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Begin"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your hair knows what it's been missing."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Give it 90 days of honest Ayurvedic nutrition. One spoon every morning. Nothing more."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Shop Kesha Combo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "Free shipping on prepaid · COD available"
    }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
