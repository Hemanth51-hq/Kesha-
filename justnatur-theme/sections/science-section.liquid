<section class="section">
  <div class="container">
    <div class="section__header reveal">
      <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="section__heading">{{ section.settings.heading }}</h2>
      <p class="section__subheading">{{ section.settings.text }}</p>
    </div>

    {%- for block in section.blocks -%}
      <div class="research-block reveal" {{ block.shopify_attributes }}>
        <div class="research-block__label">{{ block.settings.label }}</div>
        <div>
          <h3 style="margin-bottom:0.5rem">{{ block.settings.title }}</h3>
          <p class="muted" style="margin:0;max-width:40rem">{{ block.settings.text }}</p>
        </div>
      </div>
    {%- endfor -%}

    {%- if section.settings.cta_label != blank -%}
      <div style="margin-top:2.5rem">
        <a href="{{ section.settings.cta_link | default: '/pages/science' }}" class="btn btn--primary">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Science section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The science"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hair needs more than hope. It needs nutrition."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We combine Ayurvedic wisdom with modern nutritional science — iron, zinc, protein, stress support and scalp care — without miracle claims."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA",
      "default": "Read the science"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Growth cycle" },
        { "type": "text", "id": "title", "label": "Title", "default": "The 90-day hair cycle" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Hair grows in phases. Meaningful change usually needs a full cycle of consistent daily nutrition." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science section",
      "blocks": [
        { "type": "topic", "settings": { "label": "Growth cycle", "title": "The 90-day hair cycle", "text": "Hair grows in phases. Meaningful change usually needs a full cycle of consistent daily nutrition." } },
        { "type": "topic", "settings": { "label": "Nutrition", "title": "Iron, zinc & protein", "text": "Follicles are metabolically active. Deficiencies show up as thinning, shedding and slow growth." } },
        { "type": "topic", "settings": { "label": "Stress & hormones", "title": "What oils cannot fix", "text": "Stress load and hormonal shifts require internal support — not another bottle of fragrance oil." } },
        { "type": "topic", "settings": { "label": "Ayurveda", "title": "Herbs with a job to do", "text": "Amla, Bhringraj, Ashwagandha and Shatavari are chosen for traditional hair and vitality roles — in food-based form." } }
      ]
    }
  ]
}
{% endschema %}
