<section class="section">
  <div class="container" style="max-width:720px">
    <h1 style="margin-bottom:2rem">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="empty-state">
        <p>{{ 'cart.general.empty' | t }}</p>
        <a href="/collections/all" class="btn btn--primary" style="margin-top:1rem">{{ 'general.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart">
        {%- for item in cart.items -%}
          <div class="cart-item" style="grid-template-columns:88px 1fr">
            <a href="{{ item.url }}">
              {%- if item.image -%}
                <img class="cart-item__image" src="{{ item.image | image_url: width: 180 }}" alt="{{ item.title | escape }}" width="88" height="88" loading="lazy">
              {%- endif -%}
            </a>
            <div>
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <div class="cart-item__meta">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="cart-item__row">
                <label class="visually-hidden" for="updates_{{ item.key }}">Qty</label>
                <input id="updates_{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:64px;border:1px solid rgba(26,26,26,0.15);border-radius:8px;padding:0.4rem">
                <div class="price">{{ item.final_line_price | money }}</div>
              </div>
              <a href="{{ item.url_to_remove }}" class="btn btn--ghost btn--sm" style="padding:0;margin-top:0.35rem">{{ 'cart.general.remove' | t }}</a>
            </div>
          </div>
        {%- endfor -%}

        <div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid rgba(26,26,26,0.08)">
          <div style="display:flex;justify-content:space-between;font-weight:600;font-size:1.15rem;margin-bottom:0.5rem">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="muted" style="font-size:0.85rem;margin-bottom:1.25rem">{{ 'cart.general.taxes_note' | t }}</p>
          <div class="btn-group">
            <button type="submit" name="update" class="btn btn--outline">{{ 'cart.general.update' | t }}</button>
            <button type="submit" name="checkout" class="btn btn--primary">{{ 'cart.general.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
